# Optional. Leave both variables unset for process-local simulator history.
# Apply supabase/migrations/001_dashboard_storage.sql before setting these.
# Use the project base URL only; do not append /rest/v1.
SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred backend-only Supabase Secret key. Never place it in dashboard files,
# frontend builds, logs, or source control.
SUPABASE_SECRET_KEY=sb_secret_replace-with-secret-key
# Legacy compatibility only. Leave this commented out when using the Secret key.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-key
