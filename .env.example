# Server HTTP port (defaults to 3000)
PORT=3000

# Shared secret required alongside whitelisted x-device-id for physical ESP32 telemetry & heartbeats
ESP32_SECRET=

# Secret key used to sign and verify dashboard authentication JWTs
JWT_SECRET=

# Seconds before physical ESP32 telemetry is marked stale (positive integer, defaults to 30)
SENSOR_STALE_TIMEOUT_SECONDS=

# Production Supabase PostgreSQL configuration (server-side persistence; automated tests use in-memory mocks)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=